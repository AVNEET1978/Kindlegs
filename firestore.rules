rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Context-Aware Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isEmailVerified() { return request.auth.token.email_verified == true || request.auth.provider_id == 'anonymous'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // 1. User Rules
    match /users/{userId} {
      function isValidUser(data, isUpdate) {
        return (isUpdate || data.keys().hasAll(['createdAt'])) &&
               data.keys().size() <= 10 &&
               (!data.has('email') || (data.email is string && data.email.size() <= 256)) &&
               (!data.has('createdAt') || data.createdAt is timestamp) &&
               (!data.has('displayName') || (data.displayName is string && data.displayName.size() <= 200)) &&
               (!data.has('photoURL') || (data.photoURL is string && data.photoURL.size() <= 1000));
      }
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isEmailVerified() && isValidUser(incoming(), false) && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) && isEmailVerified() && isValidUser(incoming(), true) && 
                    (!incoming().has('email') || incoming().email == existing().email) &&
                    (!incoming().has('createdAt') || incoming().createdAt == existing().createdAt) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // 2. Pet Rules
    match /pets/{petId} {
      function isValidPet(data, isUpdate) {
        return (isUpdate || data.keys().hasAll(['name', 'species', 'ownerId', 'createdAt', 'dob'])) &&
               data.keys().size() <= 15 &&
               (!data.has('name') || (data.name is string && data.name.size() <= 100)) &&
               (!data.has('species') || (data.species is string && data.species.size() <= 50)) &&
               (!data.has('ownerId') || (data.ownerId == request.auth.uid && data.ownerId is string)) &&
               (!data.has('dob') || (data.dob is string && data.dob.size() <= 20)) &&
               (!data.has('createdAt') || data.createdAt is timestamp) &&
               (!data.has('breed') || (data.breed is string && data.breed.size() <= 100)) &&
               (!data.has('gender') || (data.gender in ['male', 'female', 'unknown'])) &&
               (!data.has('weight') || (data.weight is number || data.weight == null)) &&
               (!data.has('color') || (data.color is string && data.color.size() <= 50)) &&
               (!data.has('imageUrl') || (data.imageUrl is string && data.imageUrl.size() <= 2000000));
      }
      
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isValidId(petId) && isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(petId) && isSignedIn() && isValidPet(incoming(), false) && incoming().createdAt == request.time;
      allow update: if isValidId(petId) && isSignedIn() && existing().ownerId == request.auth.uid && isValidPet(incoming(), true) &&
                    (!incoming().has('ownerId') || incoming().ownerId == existing().ownerId) &&
                    (!incoming().has('createdAt') || incoming().createdAt == existing().createdAt) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'species', 'breed', 'dob', 'gender', 'weight', 'color', 'imageUrl']);
      allow delete: if isValidId(petId) && isSignedIn() && existing().ownerId == request.auth.uid;

      // 3. Medical Record Rules
      match /records/{recordId} {
        function isValidRecord(data, isUpdate) {
          return (isUpdate || data.keys().hasAll(['petId', 'type', 'date', 'title', 'ownerId', 'createdAt'])) &&
                 (!data.has('petId') || data.petId == petId) &&
                 (!data.has('ownerId') || data.ownerId == request.auth.uid) &&
                 (!data.has('type') || data.type in ['vaccine', 'deworming', 'prescription', 'report', 'visit']) &&
                 (!data.has('title') || (data.title is string && data.title.size() <= 200)) &&
                 (!data.has('date') || (data.date is string && data.date.size() <= 20)) &&
                 (!data.has('createdAt') || data.createdAt is timestamp) &&
                 (!data.has('imageUrl') || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
                 (!data.has('summary') || (data.summary is string && data.summary.size() <= 1000)) &&
                 (!data.has('nextDueDate') || (data.nextDueDate is string && data.nextDueDate.size() <= 20));
        }
        
        function isPetOwned() {
          return get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        }

        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(recordId) && isSignedIn() && isPetOwned() && resource.data.petId == petId;
        allow create: if isValidId(recordId) && isSignedIn() && isPetOwned() && isValidRecord(incoming(), false) && incoming().createdAt == request.time;
        allow update: if isValidId(recordId) && isSignedIn() && isPetOwned() && isValidRecord(incoming(), true) &&
                      (!incoming().has('petId') || incoming().petId == existing().petId) &&
                      (!incoming().has('ownerId') || incoming().ownerId == existing().ownerId) &&
                      (!incoming().has('createdAt') || incoming().createdAt == existing().createdAt) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['type', 'date', 'title', 'content', 'imageUrl', 'clinicName', 'stickersFound', 'stampsFound', 'summary', 'nextDueDate', 'metadata']);
        allow delete: if isValidId(recordId) && isSignedIn() && isPetOwned();
      }

      // 4. Reminder Rules
      match /reminders/{reminderId} {
        function isValidReminder(data, isUpdate) {
          return (isUpdate || data.keys().hasAll(['petId', 'title', 'dueDate', 'status', 'ownerId', 'createdAt'])) &&
                 (!data.has('petId') || data.petId == petId) &&
                 (!data.has('ownerId') || data.ownerId == request.auth.uid) &&
                 (!data.has('title') || (data.title is string && data.title.size() <= 200)) &&
                 (!data.has('dueDate') || (data.dueDate is string && data.dueDate.size() <= 20)) &&
                 (!data.has('status') || data.status in ['pending', 'completed']) &&
                 (!data.has('createdAt') || data.createdAt is timestamp);
        }
        
        function isPetOwned() {
          return get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        }

        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(reminderId) && isSignedIn() && isPetOwned() && resource.data.petId == petId;
        allow create: if isValidId(reminderId) && isSignedIn() && isPetOwned() && isValidReminder(incoming(), false) && incoming().createdAt == request.time;
        allow update: if isValidId(reminderId) && isSignedIn() && isPetOwned() && isValidReminder(incoming(), true) &&
                      (!incoming().has('petId') || incoming().petId == existing().petId) &&
                      (!incoming().has('ownerId') || incoming().ownerId == existing().ownerId) &&
                      (!incoming().has('createdAt') || incoming().createdAt == existing().createdAt) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'dueDate', 'status']);
        allow delete: if isValidId(reminderId) && isSignedIn() && isPetOwned();
      }
    }
  }
}
